{
  "manifest_version": 3,
  "name": "gbf肉鸽助手",
  "short_name": "gbf-solomonis-helper",
  "version": "0.1.0",
  "description": "GBF Solomonis Map Helper — 只读地图/导本辅助。Read-only map & guidebook overlay for Evoking Solomonis. No game modification.",
  "permissions": ["notifications", "storage", "system.display"],
  "host_permissions": [
    "https://game.granbluefantasy.jp/*",
    "https://prd-game-a-granbluefantasy.akamaized.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://game.granbluefantasy.jp/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://game.granbluefantasy.jp/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
